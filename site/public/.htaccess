# Reglas de host para Hostinger (Spec 04 «Despliegue y reglas de host»; Spec 06 «Dominio y producción»).
# Las URL públicas no llevan barra final, igual que los canonical del prerender.
Options -Indexes -MultiViews
DirectorySlash Off
DirectoryIndex index.html
ErrorDocument 404 /404.html

RewriteEngine On
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
# URL anteriores (src/rutas.js → rutasAnteriores); las mismas 301 están en vercel.json.
RewriteRule ^(en/|pt-br/)?experiencias/?$ /$1tours [R=301,L]
RewriteRule ^(en/|pt-br/)?servicios/?$ /$1transporte [R=301,L]
RewriteRule ^(en/|pt-br/)?vehiculos/?$ /$1transporte/alquiler-vans-buses [R=301,L]
RewriteRule ^(en/|pt-br/)?experiencias/city-tour-comuna-13/?$ /$1tours/comuna-13 [R=301,L]
RewriteRule ^(en/|pt-br/)?experiencias/guatape-piedra-del-penol/?$ /$1tours/guatape [R=301,L]
RewriteRule ^(en/|pt-br/)?experiencias/tour-nocturno-medellin/?$ /$1tours/nocturno-medellin [R=301,L]
RewriteRule ^(en/|pt-br/)?experiencias/vuelta-a-oriente/?$ /$1tours/oriente-antioqueno [R=301,L]
RewriteRule ^(en/|pt-br/)?experiencias/tour-del-cafe-medellin/?$ /$1tours/cafe-medellin [R=301,L]
RewriteRule ^(en/|pt-br/)?experiencias/hacienda-napoles/?$ /$1tours/hacienda-napoles [R=301,L]
RewriteRule ^(en/|pt-br/)?experiencias/salto-del-buey/?$ /$1tours/salto-del-buey [R=301,L]
RewriteRule ^(en/|pt-br/)?experiencias/santa-fe-de-antioquia/?$ /$1tours/santa-fe-de-antioquia [R=301,L]
RewriteRule ^(en/|pt-br/)?experiencias/jardin-antioquia/?$ /$1tours/jardin-antioquia [R=301,L]
RewriteRule ^(en/|pt-br/)?experiencias/tour-de-compras/?$ /$1tours/compras-medellin [R=301,L]
RewriteRule ^(en/|pt-br/)?experiencias/tour-miradores/?$ /$1tours/miradores-medellin [R=301,L]
RewriteRule ^(en/|pt-br/)?experiencias/traslados-aeropuerto-jmc/?$ /$1transporte/aeropuerto-medellin [R=301,L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^(.+)/$ /$1 [R=301,L]
RewriteCond %{REQUEST_FILENAME}/index.html -f
RewriteRule ^(.+)$ $1/index.html [L]

<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
